<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/icono_saludapp"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icono_saludapp"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiPrimeraApp">
        <activity
            android:name=".ui.weight.HistorialPesoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pressure.HistorialPresionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.PerfilActivity"
            android:exported="false" />
        <activity
            android:name=".ui.medication.MedicamentoActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.medication.HistorialMedicinaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.hydration.HidratacionActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.physical.ActividadFisicaActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.glucose.ControlGlucosaActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.pressure.PresionArterialActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.weight.ControlPesoActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.menu.MenuActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.menu.LoginActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.menu.RegisterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
        <activity
            android:name=".ui.menu.PrivacyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.MainActivity"
            android:exported="false" />

        <service
            android:name=".services.PedometerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

</manifest>
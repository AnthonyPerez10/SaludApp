<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo base para EditText -->
    <style name="EditTextRounded">
        <item name="android:paddingLeft">17dp</item>
        <item name="android:paddingRight">17dp</item>
        <item name="android:background">@drawable/input_rounf</item>
    </style>

    <!-- ESTILOS BASE (Necesarios para corregir errores de herencia AAPT) -->
    <style name="Text" parent="android:Widget.TextView" />
    <style name="Text.Title" />
    <style name="Text.Subtitle" />
    <style name="Text.Body" />
    <style name="Text.History" />
    <style name="Button" parent="Widget.Material3.Button" />

    <!-- Estilos de Texto específicos -->
    <style name="Text.Title.Primary">
        <item name="android:textColor">@color/peso_primary_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Title.Weight">
        <item name="android:textColor">@color/ui_weight_title_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtitle.Secondary">
        <item name="android:textColor">@color/peso_gray_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body.Secondary">
        <item name="android:textColor">@color/ui_text_secondary_666</item>
    </style>

    <style name="Text.History.Header">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilos de Botones -->
    <style name="Button.Primary">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Secondary">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
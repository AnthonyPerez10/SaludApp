<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- ICONO -->
        <ImageView
            android:id="@+id/ivIconoPresion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Icono Presión"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_presion" />

        <!-- Textos -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fecha + Hora -->
            <TextView
                android:id="@+id/tvFechaHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/peso_dark_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="01/01/2023 10:00 AM" />

            <!-- Sistólica/Diastólica + Pulso -->
            <TextView
                android:id="@+id/tvPresionValores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ui_history_item_text_secondary"
                android:textSize="13sp"
                tools:text="120/80 mmHg  •  Pulso: 72 BPM" />

            <!-- Detalle Brazo + Clasificación -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvBrazo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#ECEFF1"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    tools:text="Brazo Izquierdo"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvClasificacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@color/peso_save_green"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    tools:text="NORMAL" />
            </LinearLayout>

        </LinearLayout>

        <!-- Botón Eliminar -->
        <ImageView
            android:id="@+id/btnDeleteRecord"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/icono_eliminar"
            android:contentDescription="Eliminar registro"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

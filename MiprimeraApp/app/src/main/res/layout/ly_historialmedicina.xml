<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- ICONO DE MEDICAMENTOS -->
        <ImageView
            android:id="@+id/ivIconoMedicina"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Icono Medicamento"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/icono_medicamentos" />

        <!-- Textos y Detalles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre de Medicina -->
            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/peso_dark_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Paracetamol" />

            <!-- Dosis + Frecuencia -->
            <TextView
                android:id="@+id/tvMedDoseFrequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ui_history_item_text_secondary"
                android:textSize="13sp"
                tools:text="Dosis: 1 Pastillas  •  Cada 8 horas" />

            <!-- Duración + Inventario / Stock -->
            <TextView
                android:id="@+id/tvMedDurationInventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/peso_gray_text"
                android:textSize="12sp"
                tools:text="Duración: 7 días  •  Inventario: 20 un." />

            <!-- Fecha Registrado -->
            <TextView
                android:id="@+id/tvMedDateRegistered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#90A4AE"
                android:textSize="10sp"
                tools:text="Registrado: 02/07/2026" />

        </LinearLayout>

        <!-- Botón Eliminar -->
        <ImageView
            android:id="@+id/btnDeleteRecord"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/icono_eliminar"
            android:contentDescription="Eliminar medicamento"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

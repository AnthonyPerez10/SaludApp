<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Medicamento"
            android:textColor="@color/peso_primary_blue"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Nombre del medicamento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Medicamento"
            android:textColor="@color/peso_gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/etMedName"
            style="@style/EditTextRounded"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Ej. Paracetamol"
            android:inputType="text"
            android:maxLength="40"
            android:layout_marginBottom="12dp" />

        <!-- Dosis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosis Cantidad"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etMedDoseQty"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej. 1"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presentación"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <Spinner
                    android:id="@+id/spinnerDoseType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/input_rounf" />
            </LinearLayout>
        </LinearLayout>

        <!-- Frecuencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frecuencia de Toma"
            android:textColor="@color/peso_gray_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <Spinner
            android:id="@+id/spinnerFrequency"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/input_rounf" />

        <!-- Duracion y Stock Inicial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duración (Días)"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etDurationDays"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej. 7 (0 = Crónico)"
                    android:inputType="number" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Caja Inicial (Dosis)"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <EditText
                    android:id="@+id/etInventoryInitial"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej. 30"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

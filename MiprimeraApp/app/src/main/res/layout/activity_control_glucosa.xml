<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4EEF7"
    tools:context=".Control_Glucosa">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAppBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="#1A4373"
                android:text="AÑADIR NUEVO REGISTRO"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvDateTimeInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="REGISTRO: Hoy - Martes, 19 Octubre | 12:48 PM"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/tvAppBarTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/rowCardsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                app:layout_constraintTop_toBottomOf="@id/tvDateTimeInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VALOR DE GLUCOSA"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:gravity="center" />

                        <EditText
                            android:id="@+id/etGlucoseValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_marginTop="16dp"
                            android:hint="Ingresar Valor"
                            android:inputType="numberDecimal"
                            android:gravity="center"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1A4373"
                            android:background="@android:color/transparent" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="2dp"
                            android:background="#1A4373"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="mg/dL"
                            android:textColor="#607D8B"
                            android:textStyle="bold"
                            android:textSize="16sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TIPO DE REGISTRO"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="8dp" />

                        <RadioGroup
                            android:id="@+id/rgRecordType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Opción 1: Ayunas -->
                            <LinearLayout
                                android:id="@+id/layoutAyunas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_ayunas"
                                    android:contentDescription="Icono Ayunas" />

                                <RadioButton
                                    android:id="@+id/rbAyunas"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Ayunas"
                                    android:textSize="13sp"
                                    android:checked="true" />
                            </LinearLayout>

                            <!-- Opción 2: Antes de Almuerzo -->
                            <LinearLayout
                                android:id="@+id/layoutAntesAlmuerzo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_almuerzo"
                                    android:contentDescription="Icono Antes Almuerzo" />

                                <RadioButton
                                    android:id="@+id/rbAntesAlmuerzo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Antes de Almuerzo"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Opción 3: Después de Almuerzo -->
                            <LinearLayout
                                android:id="@+id/layoutDespuesAlmuerzo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_almuerzo2"
                                    android:contentDescription="Icono Después Almuerzo" />

                                <RadioButton
                                    android:id="@+id/rbDespuesAlmuerzo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Después de Almuerzo"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Opción 4: Cena -->
                            <LinearLayout
                                android:id="@+id/layoutCena"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_cena"
                                    android:contentDescription="Icono Cena" />

                                <RadioButton
                                    android:id="@+id/rbCena"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cena"
                                    android:textSize="13sp" />
                            </LinearLayout>

                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardOptionalNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/rowCardsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NOTAS OPCIONALES"
                            android:textColor="@android:color/black"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_alignParentStart="true" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▲"
                            android:textColor="#607D8B"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <EditText
                        android:id="@+id/etOptionalNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Añadir notas…"
                        android:inputType="textMultiLine"
                        android:gravity="top|start"
                        android:lines="3"
                        android:background="@android:color/transparent"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreviousSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/cardOptionalNotes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESUMEN PREVIO"
                        android:textColor="#607D8B"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPreviousSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Última lectura: 124 mg/dL (Antes de almuerzo; 12:48 PM)"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnSaveRecord"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:text="+ GUARDAR REGISTRO"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/cardPreviousSummary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

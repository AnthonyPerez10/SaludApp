<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_weight_background"
    android:fitsSystemWindows="true"
    tools:context=".Hidratacion_Activity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER BAR (mismo patrón que Control de Peso) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/peso_card_bg"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_agua"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/txtVTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Control de Hidratación"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvDateTimeInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REGISTRO: Hoy - Martes, 19 Octubre"
                            android:textColor="@color/peso_gray_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recordatorios de Hidratación"
                            android:textColor="@color/peso_gray_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:checked="true" />
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTELLA VISUAL Y CONTADOR -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvWaterCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 2000 ml"
                        android:textColor="@color/peso_primary_blue"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Custom Water Bottle Wave View -->
                    <pa.ac.pa.miprimeraapp.ui.custom.WaterWaveView
                        android:id="@+id/waterWaveView"
                        android:layout_width="160dp"
                        android:layout_height="260dp"
                        android:layout_margin="12dp" />

                    <TextView
                        android:id="@+id/tvProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% Completado"
                        android:textColor="@color/peso_gray_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SMART TIPS RECORDATORIOS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E0F2F1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="24sp"
                        android:layout_marginEnd="8dp"/>
                    <TextView
                        android:id="@+id/tvSmartTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carga tus datos físicos para personalizar tu meta recomendada."
                        android:textColor="#00796B"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTONES DE REGISTRO RÁPIDO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro Rápido"
                android:textColor="@color/peso_primary_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <!-- 🥛 VASO 250ml -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLog250"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#E1F5FE">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🥛"
                            android:textSize="28sp"
                            android:layout_gravity="center" />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="250 ml"
                        android:textSize="11sp"
                        android:textColor="@color/peso_primary_blue"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- 🍼 BOTELLA 500ml -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLog500"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#B3E5FC">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍾"
                            android:textSize="28sp"
                            android:layout_gravity="center" />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 ml"
                        android:textSize="11sp"
                        android:textColor="@color/peso_primary_blue"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- 🏺 TERMO 750ml -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLog750"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#81D4FA">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏺"
                            android:textSize="28sp"
                            android:layout_gravity="center" />
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="750 ml"
                        android:textSize="11sp"
                        android:textColor="@color/peso_primary_blue"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- ➕ CUSTOM -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnLogCustom"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="3dp"
                        app:cardBackgroundColor="#E0F7FA">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_plus"
                            android:layout_gravity="center"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otro"
                        android:textSize="11sp"
                        android:textColor="@color/peso_primary_blue"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CUSTOM LOGGER EXPANDABLE PANEL (SEEKBAR) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/layoutCustomLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingreso Personalizado (Contenedor)"
                        android:textColor="@color/peso_primary_blue"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvCustomAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="350 ml"
                        android:textColor="#0288D1"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"/>
                    <SeekBar
                        android:id="@+id/sbCustomAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="1500"
                        android:progress="350"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"/>
                    <Button
                        android:id="@+id/btnConfirmCustomLog"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Agregar Agua"
                        android:backgroundTint="@color/peso_primary_blue"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ESTADÍSTICAS SEMANALES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consumo Semanal (Meta Cumplida)"
                        android:textColor="@color/peso_primary_blue"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Contenedor del Gráfico de Barras -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:padding="4dp">

                        <!-- Lunes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterL"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="L"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Martes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterM"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="M"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Miércoles -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterMi"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="M"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Jueves -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterJ"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="J"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Viernes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterV"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="V"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Sábado -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterS"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="S"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <!-- Domingo -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal">
                            <View
                                android:id="@+id/barWaterD"
                                android:layout_width="8dp"
                                android:layout_height="30dp"
                                android:background="#B0BEC5" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="D"
                                android:textSize="10sp"
                                android:textColor="@color/peso_gray_text"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divisor -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/ui_divider_e0"/>

                    <!-- Panel de KPIs Semanal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Días Cumplidos"
                                android:textColor="@color/peso_gray_text"
                                android:textSize="11sp"/>

                            <TextView
                                android:id="@+id/tvWaterStreakKPI"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 7"
                                android:textColor="@color/peso_primary_blue"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Consumo Hoy"
                                android:textColor="@color/peso_gray_text"
                                android:textSize="11sp"/>

                            <TextView
                                android:id="@+id/tvWaterTodayKPI"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 ml"
                                android:textColor="@color/peso_save_green"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CONFIGURACION META INTELIGENTE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calcular Meta Ideal de Agua"
                        android:textColor="@color/peso_primary_blue"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Peso en kg -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu Peso (kg)"
                        android:textColor="@color/peso_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etUserWeight"
                        style="@style/EditTextRounded"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Ej. 70"
                        android:inputType="numberDecimal"
                        android:layout_marginBottom="12dp" />

                    <!-- Genero -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Género"
                        android:textColor="@color/peso_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <RadioGroup
                        android:id="@+id/rgUserGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/rbMale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Masculino"
                            android:checked="true"
                            android:layout_marginEnd="24dp"/>
                        <RadioButton
                            android:id="@+id/rbFemale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Femenino"/>
                    </RadioGroup>

                    <!-- Nivel actividad -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nivel de Actividad"
                        android:textColor="@color/peso_gray_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <Spinner
                        android:id="@+id/spinnerUserActivity"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/input_rounf" />

                    <!-- Calcular y aplicar -->
                    <Button
                        android:id="@+id/btnCalculateGoal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Calcular y Guardar Meta"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/peso_primary_blue"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
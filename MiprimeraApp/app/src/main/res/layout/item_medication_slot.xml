<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- ICONO DE DOSIS -->
        <ImageView
            android:id="@+id/ivMedIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_pill"
            android:background="#E1F5FE"
            android:padding="8dp"
            android:layout_marginEnd="12dp"/>

        <!-- INFORMACION DEL MEDICAMENTO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMedNameDose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paracetamol - 500mg"
                android:textColor="#112E52"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 AM"
                android:textColor="#0288D1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvMedDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tratamiento: Por 7 días"
                android:textColor="@color/peso_gray_text"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- BOTON DE ACCION BINARIA (TOMAR / TOMADO) -->
        <Button
            android:id="@+id/btnTakeAction"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:text="Tomar"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/peso_primary_blue"
            app:cornerRadius="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>

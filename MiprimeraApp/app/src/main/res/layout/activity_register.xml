<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_menu_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/saludapplogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear Cuenta"
                    android:textColor="@color/peso_primary_blue"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresa tus datos para registrarte"
                    android:textColor="@color/peso_gray_text"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:layout_gravity="center_horizontal" />

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="@color/peso_dark_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: Anthony"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apellido"
                    android:textColor="@color/peso_dark_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etApellido"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: Perez"
                    android:inputType="textPersonName"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Edad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad"
                    android:textColor="@color/peso_dark_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEdad"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: 25"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Correo (etEmail) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico"
                    android:textColor="@color/peso_dark_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="correo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <!-- Contraseña (etPassword) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contraseña"
                    android:textColor="@color/peso_dark_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/EditTextRounded"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Mínimo 4 caracteres"
                    android:inputType="textPassword"
                    android:drawableEnd="@android:drawable/ic_menu_view"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp" />

                <!-- Checkbox Terminos -->
                <CheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acepto los términos para compartir mis datos de salud"
                    android:textColor="@color/ui_text_secondary_666"
                    android:textSize="12sp"
                    android:layout_marginBottom="24dp" />

                <!-- Botón Registrarse (btnEnviar) -->
                <Button
                    android:id="@+id/btnEnviar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Registrarse"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/peso_primary_blue"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Link a Login -->
                <TextView
                    android:id="@+id/tvGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? Iniciar sesión"
                    android:textColor="@color/peso_primary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

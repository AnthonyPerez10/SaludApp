<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Control_peso">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ui_weight_background"
        android:fillViewport="true"
        android:clipToPadding="false"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/peso_card_bg"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_peso"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/txtVTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Control de Peso"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tvDateTimeInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REGISTRO: Hoy - Martes, 19 Octubre"
                            android:textColor="@color/peso_gray_text"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- PANEL DE ESTADÍSTICAS Y KPIS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWeightStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADÍSTICAS DE PESO"
                        android:textColor="@color/ui_weight_title_blue"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- Peso Inicial -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Inicial"
                                android:textColor="@color/peso_gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStatWeightInitial"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/peso_primary_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Peso Actual -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Actual"
                                android:textColor="@color/peso_gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStatWeightCurrent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/peso_primary_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Variación -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diferencia"
                                android:textColor="@color/peso_gray_text"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStatWeightDiff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/peso_save_green"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtVsubtitle_edad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edad"
                        android:textColor="@color/ui_weight_title_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/txtNedad"
                        style="@style/EditTextRounded"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Ej: 25"
                        android:maxLength="3"
                        android:inputType="number"
                        android:textColorHint="@color/ui_hint_grey_9e"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/txtVsubtitle_peso"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Peso"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swPesoUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KG / LB"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:thumbTint="@color/ui_weight_title_blue"
                            android:trackTint="@color/ui_weight_title_blue"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPeso"
                        style="@style/EditTextRounded"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Peso (kg)"
                        android:maxLength="3"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/ui_hint_grey_9e"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/txtVsubtitle_esttura"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estatura"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swEstaturaUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CM / IN"
                            android:textColor="@color/ui_weight_title_blue"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:thumbTint="@color/ui_weight_title_blue"
                            android:trackTint="@color/ui_weight_title_blue"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etEstatura"
                        style="@style/EditTextRounded"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Estatura (cm)"
                        android:maxLength="3"
                        android:inputType="numberDecimal"
                        android:textColorHint="@color/ui_hint_grey_9e"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CALCULAR"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="@color/ui_weight_title_blue"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="VER HISTORIAL"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="@color/peso_gray_text"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:layout_marginBottom="32dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/txtVr_IMC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IMC"
                                android:textColor="@color/ui_text_secondary_666"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvIMC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/peso_save_green"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/txtr_Peso"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Peso Ideal"
                                android:textColor="@color/ui_text_secondary_666"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvPesoIdeal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/peso_save_green"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/txtr_grasa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grasa"
                                android:textColor="@color/ui_text_secondary_666"
                                android:textSize="13sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvGrasa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/peso_save_green"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/ui_divider_e0"/>

                    <TextView
                        android:id="@+id/tvClasificacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Resultados"
                        android:textColor="@color/ui_weight_title_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>